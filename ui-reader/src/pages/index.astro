---
import Layout from "../layouts/Layout.astro";
import ArticlePreview from "../components/ArticlePreview.astro";

const PAGE_SIZE = 12;
const API_BASE = import.meta.env.PUBLIC_API_BASE;

const [articleRes, catRes] = await Promise.all([
  fetch(`${API_BASE}/article?size=${PAGE_SIZE}&page=0`),
  fetch(`${API_BASE}/category`)
]);

const data = await articleRes.json();
const categories = await catRes.json();

const catMap = Object.fromEntries(categories.map(c => [c.id, c.name]));

const articles = data.articleSummaryList.map(a => ({
  ...a,
  categoryName: catMap[a.categoryId] || ''
}));

const featuredArticle = articles[0];
const restArticles = articles.slice(1);
const hasSingleSmall = articles.length === 2;
---

<Layout title="Hikmet Cakir: Home">
  <div class="blog-wrapper"
    data-api-base={import.meta.env.CLIENT_PUBLIC_API_BASE}
    data-page-size={PAGE_SIZE}
    data-cat-map={JSON.stringify(catMap)}>

    {articles.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : articles.length === 1 ? (
      <div id="articles-grid">
        <div class="solo-grid">
          <ArticlePreview article={featuredArticle} variant="small" key={featuredArticle.id} />
        </div>
      </div>
    ) : hasSingleSmall ? (
      <div id="articles-grid">
        <div class="duo-grid">
          <ArticlePreview article={featuredArticle} variant="small" key={featuredArticle.id} />
          <ArticlePreview article={restArticles[0]} variant="small" key={restArticles[0].id} />
        </div>
      </div>
    ) : (
      <div id="articles-grid">
        <div class="group-block">
          <ArticlePreview article={featuredArticle} variant="featured" />
          <div class="small-pair">
            {restArticles.slice(0, 2).map((article) => (
              <ArticlePreview article={article} variant="small" key={article.id} />
            ))}
          </div>
        </div>
        <div id="extra-grid">
          {restArticles.slice(2).map((article) => (
            <ArticlePreview article={article} variant="small" key={article.id} />
          ))}
        </div>
      </div>
    )}

    <div id="scroll-sentinel" class="h-8"></div>
    <div id="loader" class="hidden fixed left-1/2 -translate-x-1/2 bottom-4 z-50 transform">
      <div class="animate-spin h-8 w-8 border-2 border-gray-300 border-t-black rounded-full"></div>
    </div>
    <div id="retry" class="flex justify-center py-4 hidden">
      <button class="px-4 py-2 border border-black rounded-full hover:bg-black hover:text-white">Tekrar Dene</button>
    </div>
  </div>

  <script is:inline>
    import('/src/scripts/articles.js').then(m => m.initInfiniteScroll());
  </script>
</Layout>

<style>
  .blog-wrapper {
    padding: 3rem 15%;
  }

  .empty {
    text-align: center;
    color: #6b7280;
    padding: 4rem 0;
  }

  .solo-grid {
    display: grid;
    grid-template-columns: repeat(1, 400px);
    gap: 20px;
  }

  .duo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .group-block {
    display: grid;
    grid-template-columns: 1.65fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .small-pair {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  #extra-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 20px;
  }

  @media (max-width: 1024px) {
    .blog-wrapper {
      padding: 3rem 5%;
    }
  }

  @media (max-width: 900px) {
    .blog-wrapper {
      padding: 2rem 4%;
    }
    .group-block {
      grid-template-columns: 1fr;
    }
    .small-pair {
      flex-direction: row;
    }
    .duo-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .blog-wrapper {
      padding: 1.5rem 16px 2rem;
      overflow-x: hidden;
    }
    .group-block {
      grid-template-columns: 1fr;
    }
    .small-pair {
      flex-direction: column;
    }
    #extra-grid {
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    }
    .duo-grid {
      grid-template-columns: 1fr;
    }
    .solo-grid {
      grid-template-columns: 1fr;
    }
  }
</style>