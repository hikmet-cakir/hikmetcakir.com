---
import Layout from "../../layouts/Layout.astro";
import ArticleDetail from "../../components/ArticleDetail.astro";
 
export const prerender = false;
 
const { id } = Astro.params;

if (!id) {
  throw new Error("Article ID is required");
}
 
let article;

try {
  const API = import.meta.env.PUBLIC_API_BASE;
  const res = await fetch(`${API}/article?id=${id}&size=10&page=0`);
  
  if (!res.ok) {
    return Astro.redirect('/404');
  }
  
  const data = await res.json();
  article = data.articleSummaryList?.[0];

  if (!article) {
    return Astro.redirect('/404');
  }
} catch (error) {
  console.error('Error fetching article:', error);
  return Astro.redirect('/404');
}
---

<Layout title={article?.title || 'Article Not Found'}>
  <ArticleDetail article={article} isPreview={false} />
</Layout>
