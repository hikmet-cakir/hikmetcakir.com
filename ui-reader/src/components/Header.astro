---
import '../styles/search-bar.css';

const API = import.meta.env.PUBLIC_API_BASE;
const res = await fetch(`${API}/category/hierarchy?levels=1,2`);
const categories = await res.json();
---

<header class="w-full bg-black">
  <div class="flex h-14 justify-between items-center" style="padding-left:15%; padding-right:15%;"> 
    <div class="flex items-center gap-1 text-white font-bold text-xl">
      <a href="/" aria-label="Go to homepage" class="inline-flex items-center justify-center hover:text-gray-300 hover:bg-gray-700 whitespace-nowrap px-2 py-3 rounded-md transition-colors duration-200">
        <i class="bi bi-house-fill text-white text-[18px] leading-none" aria-hidden="true"></i>
      </a>
      <a href="/me" class="hover:text-gray-300 hover:bg-gray-700 whitespace-nowrap mr-2 px-2 py-2 rounded-md transition-colors duration-200">
        Hikmet Cakir
      </a>
    </div>
 
    <nav class="hidden md:flex text-white relative" id="navbar">
      {
        categories.map(root => (
          <div class="relative" key={root.id}>
            <a href={`/category/${root.id}`} class="hover:text-gray-300 hover:bg-gray-700 whitespace-nowrap w-full mr-2 px-2 py-1.5 rounded-md transition-colors duration-200">
              {root.name}
            </a>
            {root.children && root.children.length > 0 && (
              <div class="absolute left-0 top-full flex flex-col bg-black mt-2 rounded-md shadow-lg min-w-[180px] z-50 hidden">
                {root.children.map(child => (
                  <a key={child.id} href={`/category/${child.id}`} class="block px-4 py-2 hover:bg-gray-700 hover:text-white transition-colors duration-150">
                    {child.name}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }

      <div class="container" id="search-container">
        <input type="text" name="text" id="search-input" class="input" required="" placeholder="Type to search...">
        <div class="icon">
          <svg xmlns="http://www.w3.org/2000/svg" class="ionicon" viewBox="0 0 512 512">
            <title>Search</title>
            <path d="M221.09 64a157.09 157.09 0 10157.09 157.09A157.1 157.1 0 00221.09 64z" fill="none" stroke="currentColor" stroke-miterlimit="10" stroke-width="32"></path>
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-miterlimit="10" stroke-width="32" d="M338.29 338.29L448 448"></path>
          </svg>
        </div>
        <div id="search-results" class="search-results hidden"></div>
      </div>
    </nav>
 
    <div class="flex md:hidden items-center gap-2"> 
      <button id="mobile-search-btn" class="text-white p-2 rounded-md hover:bg-gray-700 transition-colors duration-200" aria-label="Search">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 512 512" fill="none" stroke="currentColor" stroke-width="32" stroke-miterlimit="10">
          <path d="M221.09 64a157.09 157.09 0 10157.09 157.09A157.1 157.1 0 00221.09 64z"/>
          <path stroke-linecap="round" d="M338.29 338.29L448 448"/>
        </svg>
      </button>
 
      <button id="mobile-menu-btn" class="text-white p-2 rounded-md hover:bg-gray-700 transition-colors duration-200" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>
 
  <div id="mobile-search-bar" class="hidden md:hidden px-4 pb-3">
    <div class="relative">
      <input
        type="text"
        id="mobile-search-input"
        placeholder="Type to search..."
        class="w-full bg-gray-800 text-white placeholder-gray-400 rounded-md px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-gray-500"
      />
      <div class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 512 512" fill="none" stroke="currentColor" stroke-width="32" stroke-miterlimit="10">
          <path d="M221.09 64a157.09 157.09 0 10157.09 157.09A157.1 157.1 0 00221.09 64z"/>
          <path stroke-linecap="round" d="M338.29 338.29L448 448"/>
        </svg>
      </div>
      <div id="mobile-search-results" class="search-results hidden"></div>
    </div>
  </div>
 
  <div id="mobile-menu" class="hidden md:hidden bg-black border-t border-gray-800">
    {
      categories.map(root => (
        <div class="mobile-category" key={root.id}>
          <div class="flex items-center justify-between px-4 py-3">
            <a href={`/category/${root.id}`} class="text-white text-base font-medium hover:text-gray-300 transition-colors duration-200 flex-1">
              {root.name}
            </a>
            {root.children && root.children.length > 0 && (
              <button class="mobile-toggle-btn text-gray-400 hover:text-white p-1 transition-colors duration-200" aria-label="Toggle submenu">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
            )}
          </div>
          {root.children && root.children.length > 0 && (
            <div class="mobile-submenu hidden bg-gray-900">
              {root.children.map(child => (
                <a key={child.id} href={`/category/${child.id}`} class="block px-8 py-2.5 text-gray-300 hover:text-white hover:bg-gray-700 transition-colors duration-150 text-sm">
                  {child.name}
                </a>
              ))}
            </div>
          )}
        </div>
      ))
    }
  </div>
</header>

<script type="module"> 
const navbar = document.getElementById('navbar');
if (navbar) {
  navbar.querySelectorAll(':scope > div.relative').forEach(parentDiv => {
    const dropdown = parentDiv.querySelector('div.absolute');
    if (!dropdown) return;
    let timeout;
    parentDiv.addEventListener('mouseenter', () => { clearTimeout(timeout); dropdown.classList.remove('hidden'); });
    parentDiv.addEventListener('mouseleave', () => { timeout = setTimeout(() => dropdown.classList.add('hidden'), 100); });
  });
}
 
const mobileMenuBtn = document.getElementById('mobile-menu-btn');
const mobileMenu    = document.getElementById('mobile-menu');

mobileMenuBtn?.addEventListener('click', () => {
  mobileMenu.classList.toggle('hidden');
});
 
document.querySelectorAll('.mobile-toggle-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const submenu = btn.closest('.mobile-category').querySelector('.mobile-submenu');
    const icon    = btn.querySelector('svg');
    submenu?.classList.toggle('hidden');
    icon?.classList.toggle('rotate-180');
  });
});
 
const mobileSearchBtn = document.getElementById('mobile-search-btn');
const mobileSearchBar = document.getElementById('mobile-search-bar');
const mobileSearchInput = document.getElementById('mobile-search-input');

mobileSearchBtn?.addEventListener('click', () => {
  mobileSearchBar.classList.toggle('hidden');
  if (!mobileSearchBar.classList.contains('hidden')) {
    mobileSearchInput?.focus();
  }
});
 
document.addEventListener('click', (e) => {
  if (!mobileMenuBtn?.contains(e.target) && !mobileMenu?.contains(e.target)) {
    mobileMenu?.classList.add('hidden');
  }
  if (!mobileSearchBtn?.contains(e.target) && !mobileSearchBar?.contains(e.target)) {
    mobileSearchBar?.classList.add('hidden');
  }
});
 
const API_BASE = 'https://hikmetcakir.com/api';
const pageSize = 4;

function truncate(text, maxLength = 100) {
  if (!text) return "";
  return text.length > maxLength ? text.substring(0, maxLength) + "..." : text;
}

function createResultItem(article, container) {
  const item = document.createElement('div');
  item.className = 'search-result-item';
  item.innerHTML = `
    <div class="search-result-title">${article.title || 'Untitled'}</div>
    <div class="search-result-content">${truncate(article.content || '')}</div>
  `;
  item.addEventListener('click', () => { window.location.href = `/article/${article.id}`; });
  return item;
}

function createPaginationControls(page, totalPages, totalCount, query, onPageChange) {
  const paginationDiv = document.createElement('div');
  paginationDiv.className = 'search-pagination';
  const controls = document.createElement('div');
  controls.className = 'search-pagination-controls';

  const prevBtn = document.createElement('button');
  prevBtn.className = 'search-pagination-btn';
  prevBtn.textContent = '❮';
  prevBtn.disabled = page === 0;
  prevBtn.addEventListener('click', (e) => { e.stopPropagation(); if (page > 0) onPageChange(page - 1); });

  const pageInfo = document.createElement('span');
  pageInfo.className = 'search-pagination-info';
  pageInfo.textContent = totalCount > 0
    ? `${page * pageSize + 1}-${Math.min((page + 1) * pageSize, totalCount)} / ${totalCount}`
    : `Page ${page + 1} / ${totalPages || 1}`;

  const nextBtn = document.createElement('button');
  nextBtn.className = 'search-pagination-btn';
  nextBtn.textContent = '❯';
  nextBtn.disabled = page >= totalPages - 1;
  nextBtn.addEventListener('click', (e) => { e.stopPropagation(); if (page < totalPages - 1) onPageChange(page + 1); });

  controls.appendChild(prevBtn);
  controls.appendChild(pageInfo);
  controls.appendChild(nextBtn);
  paginationDiv.appendChild(controls);
  return paginationDiv;
}

function setupSearch(inputEl, resultsEl) {
  if (!inputEl || !resultsEl) return;

  let searchTimeout;
  let abortController = null;
  let currentPage = 0;
  let currentQuery = '';
  let totalPages = 0;
  let totalCount = 0;

  function showLoading() {
    resultsEl.innerHTML = '<div class="search-results-loading">Aranıyor...</div>';
    resultsEl.classList.remove('hidden');
  }

  function hideResults() { resultsEl.classList.add('hidden'); }

  function showResults(articles, tp, tc, query) {
    resultsEl.innerHTML = '';
    if (articles.length === 0) {
      resultsEl.innerHTML = '<div class="search-results-empty">Sonuç bulunamadı</div>';
    } else {
      articles.slice(0, pageSize).forEach(a => resultsEl.appendChild(createResultItem(a)));
      if (tp > 1 || tc > pageSize) {
        resultsEl.appendChild(createPaginationControls(currentPage, tp, tc, query, (p) => {
          currentPage = p;
          performSearch(query, p);
        }));
      }
    }
    resultsEl.classList.remove('hidden');
  }

  async function performSearch(query, page = 0) {
    if (!query?.trim()) { hideResults(); return; }
    if (query !== currentQuery) { currentPage = 0; currentQuery = query; }
    else { currentPage = page; }

    if (abortController) abortController.abort();
    abortController = new AbortController();
    showLoading();

    try {
      for (const paramName of ['query', 'q', 'search', 'text', 'keyword']) {
        try {
          const url = `${API_BASE}/article/lookup?${paramName}=${encodeURIComponent(query)}&page=${page}&size=${pageSize}`;
          const response = await fetch(url, { signal: abortController.signal, headers: { 'Accept': 'application/json' } });
          if (response.ok) {
            const data = await response.json();
            let articles = data.articleSummaryList || data.articles || data || [];
            if (!Array.isArray(articles)) articles = [];
            let apiTotalCount = data.totalCount || data.totalElements || data.total || articles.length;
            let apiTotalPages = data.totalPages;
            if (articles.length > pageSize) articles = articles.slice(page * pageSize, (page + 1) * pageSize);
            totalPages = apiTotalPages ?? (apiTotalCount > 0 ? Math.ceil(apiTotalCount / pageSize) : page + 1);
            totalCount = apiTotalCount;
            showResults(articles, totalPages, totalCount, query);
            break;
          } else if (response.status !== 400) {
            throw new Error(`Search failed: ${response.status}`);
          }
        } catch (err) {
          if (err.name === 'AbortError') throw err;
        }
      }
    } catch (err) {
      if (err.name === 'AbortError') return;
      resultsEl.innerHTML = `<div class="search-results-empty">Hata: ${err.message}</div>`;
      resultsEl.classList.remove('hidden');
    } finally {
      abortController = null;
    }
  }

  inputEl.addEventListener('input', (e) => {
    const query = e.target.value.trim();
    clearTimeout(searchTimeout);
    if (!query) { hideResults(); return; }
    searchTimeout = setTimeout(() => performSearch(query, 0), 300);
  });

  inputEl.addEventListener('focus', () => {
    const query = inputEl.value.trim();
    if (query && resultsEl.classList.contains('hidden')) performSearch(query, 0);
  });

  inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { hideResults(); inputEl.blur(); }
  });

  document.addEventListener('click', (e) => {
    if (!inputEl.contains(e.target) && !resultsEl.contains(e.target)) hideResults();
  });
}
 
setupSearch(
  document.getElementById('search-input'),
  document.getElementById('search-results')
);
 
setupSearch(
  document.getElementById('mobile-search-input'),
  document.getElementById('mobile-search-results')
);
</script>