---
import Header from "../components/Header.astro"; 
import '../styles/global.css';
import '../styles/background.css';

const { title } = Astro.props;
---

<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Software developer sharing insights on Java, Spring Boot, and modern software engineering." />
    <meta name="author" content="Hikmet Cakir" />
    <meta name="robots" content="index, follow" />
 
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Software developer sharing insights on Java, Spring Boot, and modern software engineering." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hikmet Cakir" />
 
    <link rel="canonical" href={Astro.url.href} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <title>{title}</title> 
  </head>
  <body class="text-gray-900">
    <Header />
    <main class="mt-8">
      <slot />
    </main>
  </body>
</html>