--- 
import BaseLayout from '../../layouts/BaseLayout.astro';  

const API_BASE = import.meta.env.PUBLIC_API_BASE;

const pageSize = 10;
const currentPage = Number(Astro.url.searchParams.get('page') || '0');
const categoriesRes = await fetch(`${API_BASE}/category`);
const allCategories = await categoriesRes.json();
const totalCategories = allCategories.length;
const totalPages = Math.ceil(totalCategories / pageSize);
const startIndex = currentPage * pageSize;
const endIndex = startIndex + pageSize;
const categories = allCategories.slice(startIndex, endIndex);
const hasNextPage = currentPage < totalPages - 1;
const hasPreviousPage = currentPage > 0;
--- 
<BaseLayout>
      <div class="main-content">
        <div class="page-title">
          <div class="title">Category</div>
          <div class="action-buttons"> 
            <button  id="btnAddNew" class="btn btn-primary">
              <i class="fas fa-plus"></i>
              Add New
            </button>
          </div>
        </div>
  
        <div class="table-card">  
          <table class="data-table">
            <thead>
                <th>ID</th>
                <th>Name</th>
                <th>Parent Id</th> 
                <th>Actions</th>
            </thead>
            <tbody>
                {
                categories.length === 0 ? (
                  <tr>
                    <td colspan="6" style="text-align:center;">No articles found.</td>
                  </tr>
                ) : (
                  categories.map((category: any) => (
                    <tr>
                      <td>{category.id}</td>
                      <td>{category.name}</td>
                      <td>{category.parentId}</td> 
                      <td>
                        <div style="display:flex; gap:6px; flex-wrap:nowrap; justify-content:flex-start; align-items:center; max-width:100%; overflow:hidden;">
                        <button class="btn btn-outline btn-sm"
                                style="width:auto; min-width:75px; padding:4px 6px;"
                                onclick={`window.location.href='/admin/category/${category.id}'`}>
                        <i class="fas fa-pen"></i> Edit
                        </button>            
                            <button
                                class="btn btn-outline btn-sm btn-delete"
                                data-id={category.id}
                                style="width:auto; min-width:75px; padding:4px 6px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                      </td>
                    </tr>
                  ))
                )
              }
            </tbody>
          </table>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px; padding: 0 10px;">
          <div>
            <button 
              id="btnPrevious" 
              class="btn btn-outline"
              disabled={!hasPreviousPage}
              style={hasPreviousPage ? "" : "opacity: 0.5; cursor: not-allowed;"}
            >
              <i class="fas fa-chevron-left"></i> Previous
            </button>
          </div>
          <div style="font-size: 14px; color: #666;">
            Page {currentPage + 1} of {totalPages > 0 ? totalPages : 1}
          </div>
          <div>
            <button 
              id="btnNext" 
              class="btn btn-outline"
              disabled={!hasNextPage}
              style={hasNextPage ? "" : "opacity: 0.5; cursor: not-allowed;"}
            >
              Next <i class="fas fa-chevron-right"></i>
            </button>
          </div>
        </div>
      </div>
    </div>

     <script>
      const API_BASE = document.body.dataset.apiBase;

      document.addEventListener("DOMContentLoaded", () => {
        const deleteButtons = document.querySelectorAll(".btn-delete");
        deleteButtons.forEach(btn => {
          btn.addEventListener("click", async () => {
            const id = (btn as HTMLButtonElement).dataset.id;
            if (!confirm("Are you sure you want to delete this category?")) return;

            try {
              const res = await fetch(`http://localhost/api/category/${id}`, {
                method: "DELETE",
                credentials: "include"
              });

              if (res.ok) {
                alert("Category deleted successfully!");
                location.reload();
              } else {
                const msg = await res.text();
                alert("Failed to delete category: " + msg);
              }
            } catch (err) {
              alert("Error: " + (err as Error).message);
            }
          });
        });
      });

      const addBtn = document.getElementById("btnAddNew");
      if (addBtn) {
        addBtn.addEventListener("click", () => { window.location.href = "/admin/category/new"; });
      }

      const prevBtn = document.getElementById("btnPrevious") as HTMLButtonElement | null;
      if (prevBtn && !prevBtn.disabled) {
        prevBtn.addEventListener("click", () => {
          const currentPage = new URLSearchParams(window.location.search).get('page') || '0';
          const newPage = Math.max(0, parseInt(currentPage) - 1);
          window.location.href = `/admin/category${newPage > 0 ? `?page=${newPage}` : ''}`;
        });
      }

      const nextBtn = document.getElementById("btnNext") as HTMLButtonElement | null;
      if (nextBtn && !nextBtn.disabled) {
        nextBtn.addEventListener("click", () => {
          const currentPage = new URLSearchParams(window.location.search).get('page') || '0';
          const newPage = parseInt(currentPage) + 1;
          window.location.href = `/admin/category?page=${newPage}`;
        });
      }
    </script>
</BaseLayout>