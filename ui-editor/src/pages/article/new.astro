--- 
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/quill-code-block.css';
--- 
    <BaseLayout> 
      <slot slot="head">
        <link rel="stylesheet" href="https://cdn.quilljs.com/1.3.6/quill.snow.css" />
      </slot>
      <div class="main-content">
  
        <div class="page-title">
          <div class="title">Article Add</div> 
        </div>

        <div class="article-title-box">
          <label for="articleTitle">Title</label>
          <input type="text" id="articleTitle" placeholder="Enter article title..." />
        </div>

        <div class="article-title-box">
          <label for="articleCategory">Category</label>
          <select id="articleCategory">
            <option value="">Loading categories...</option>
          </select>
        </div>

        <div class="article-title-box">
          <label for="articleThumbnail">Thumbnail</label>
          <input type="file" id="articleThumbnail" accept="image/*" />
          <div id="thumbnailPreview" style="margin-top: 10px; display: none;">
            <img id="thumbnailImg" src="" alt="Preview" style="max-width: 300px; max-height: 200px; border-radius: 8px; object-fit: cover;" />
            <p id="thumbnailStatus" style="font-size: 12px; color: #6b7280; margin-top: 4px;"></p>
          </div>
        </div>

        <div id="editor-container" style="height:400px;"></div>

        <div class="action-buttons"> 
          <button id="btnSave" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            Save
          </button>
        </div> 
      </div>

    <script src="/src/scripts/article-create.js" />
</BaseLayout>