--- 
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/quill-code-block.css';
 
const API_BASE = import.meta.env.PUBLIC_API_BASE;
 
export const prerender = false;

export async function getStaticPaths() {
  return [];
} 
const { id } = Astro.params;
let article = {};
let categories = []; 
if (id) {
  const res = await fetch(`${API_BASE}/article?id=${id}&size=10&page=0`);
  const data = await res.json();
  article = data.articleSummaryList[0];
   
  const categoriesRes = await fetch(`${API_BASE}/category`);
  categories = await categoriesRes.json();
} 
--- 
<BaseLayout> 
  <slot slot="head">
    <link rel="stylesheet" href="https://cdn.quilljs.com/1.3.6/quill.snow.css" />
  </slot>
  <div class="main-content" data-article-id={id}>

    <div class="page-title">
      <div class="title">Article Edit</div> 
    </div>  

    <div class="article-title-box">
      <label for="articleTitle">Title</label>
      <input type="text" id="articleTitle" value={article?.title || ""} placeholder="Enter article title..." />
    </div>

    <div class="article-title-box">
      <label for="articleCategory">Category</label>
      <select id="articleCategory">
        <option value="">Select category...</option>
        {categories.map(cat => (
          <option value={cat.id} selected={article?.categoryId === cat.id}>{cat.name}</option>
        ))}
      </select>
    </div>

    <div class="article-title-box">
      <label for="articleThumbnail">Thumbnail</label>
      {article?.thumbnail && (
        <div style="margin-bottom: 10px;">
          <img src={article.thumbnail} alt="Current thumbnail" style="max-width: 300px; max-height: 200px; border-radius: 8px; object-fit: cover;" />
          <p style="font-size: 12px; color: #6b7280; margin-top: 4px;">Current thumbnail</p>
        </div>
      )}
      <input type="file" id="articleThumbnail" accept="image/*" />
      <div id="thumbnailPreview" style="margin-top: 10px; display: none;">
        <img id="thumbnailImg" src="" alt="Preview" style="max-width: 300px; max-height: 200px; border-radius: 8px; object-fit: cover;" />
        <p id="thumbnailStatus" style="font-size: 12px; color: #6b7280; margin-top: 4px;"></p>
      </div>
    </div>

    <div id="editor-container" style="height:400px;" set:html={article?.content}></div> 
    
    <div class="action-buttons"> 
      <button id="btnSave" class="btn btn-primary">
        <i class="fas fa-plus"></i>
        Edit
      </button> 
    </div> 
  </div>

  <script src="/src/scripts/article-edit.js" />
</BaseLayout>